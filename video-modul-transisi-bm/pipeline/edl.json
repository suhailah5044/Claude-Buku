   "start": 26.848,
   "end": 32.061
  },
  {
   "seg": 8,
   "label": "KV ni maksudnya consonant dan juga vocal.",
   "src": 74.0,
   "start": 32.061,
   "end": 34.667
  },
  {
   "seg": 9,
   "label": "Anak kita akan belajar kenal bunyi huruf, gabungan bunyi untuk membentuk suku kata.",
   "src": 82.9333,
   "start": 34.667,
   "end": 38.97
  },
  {
   "seg": 10,
   "label": "Apa yang dimaksudkan dengan suku kata KVK? K ni consonant, V ni pula ialah vocal dan K ni ialah consonant. Jadi dekat sini contohnya, bas. B, A, S.",
   "src": 129.4333,
   "start": 38.97,
   "end": 51.757
  },
  {
   "seg": 11,
   "label": "Contoh soalan je begini,",
   "src": 148.8667,
   "start": 51.757,
   "end": 53.394
  },
  {
   "seg": 12,
   "label": "dekat sini anak kita perlu kenal huruf, sebut bunyi dan gabungkan semuanya untuk membaca satu perkataan.",
