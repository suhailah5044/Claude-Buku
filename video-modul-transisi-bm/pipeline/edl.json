 "segments": [
  {
   "seg": 0,
   "label": "Parents, kalau anak bakal masuk tahun satu,",
   "src": 10.1667,
   "start": 0.0,
   "end": 2.333
  },
  {
   "seg": 1,
   "label": "saya nak perkenalkan buku kemahiran asas membaca, menulis dan juga mengira.",
   "src": 17.2,
   "start": 2.333,
   "end": 6.909
  },
  {
   "seg": 2,
   "label": "Modul transisi tahun satu yang baru ni. Ini edisi 2027.",
   "src": 23.6333,
   "start": 6.909,
   "end": 11.576
  },
  {
   "seg": 3,
   "label": "Dalam modul ni ada sains awal, ada matematik awal, ada bahasa, ada English dan juga bahasa Melayu.",
   "src": 37.7,
   "start": 11.576,
   "end": 18.394
  },
  {
   "seg": 4,
   "label": "Buku ini sesuai untuk jadikan latihan untuk bantu anak biasakan diri dengan aktiviti pembelajaran",
   "src": 46.0667,
   "start": 18.394,
   "end": 22.545
  },
  {
   "seg": 5,
   "label": "sebelum melangkah ke tahun satu.",
